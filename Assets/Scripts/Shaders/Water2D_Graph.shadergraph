        {
            "m_Id": "ee55ff6600112233aa11bb22cc33dd44"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "WaterSurface",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float time = _Time.y;\n    float waveScale = 2.4; float waveSpeed = 0.6; float waveAmount = 0.045;\n    float3 deepColor = float3(0.03, 0.15, 0.2);\n    float3 shallowColor = float3(0.16, 0.4, 0.42);\n    float3 skyColor = float3(0.5, 0.75, 0.72); float skyStrength = 0.12;\n    float3 foamColor = float3(0.9, 1.3, 1.25); float foamAlpha = 0.8; float foamWidth = 0.05;\n    float3 causticColor = float3(0.8, 1.1, 0.95); float causticAlpha = 0.35;\n    float causticScale = 16; float causticSpeed = 0.5; float causticStrength = 0.5;\n    float2 lightDir = float2(0.5, 0.85);\n    float3 specularColor = float3(1.1, 1.2, 1.0); float specularAlpha = 0.4; float shininess = 32;\n    float sparkleScale = 34; float sparkleThreshold = 0.93;\n    float freqMul[4] = {1.0, 1.9, 3.3, 5.7};\n    float ampMul[4] = {1.0, 0.5, 0.28, 0.14};\n    float speedMul[4] = {1.0, -1.4, 1.7, -2.3};\n    float phase[4] = {0.0, 2.1, 4.6, 1.3};\n    float height = 0; float slope = 0;\n    for (int i = 0; i < 4; i++) {\n        float k = waveScale * freqMul[i];\n        float w = k * uv.x - time * waveSpeed * speedMul[i] + phase[i];\n        float a = waveAmount * ampMul[i];\n        height += a * sin(w);\n        slope += a * k * cos(w);\n    }\n    float depth = saturate(uv.y - height);\n    float3 baseColour = lerp(deepColor, shallowColor, depth);\n    float fresnel = pow(depth, 2.2);\n    color = lerp(baseColour, skyColor, fresnel * skyStrength);\n    alpha = lerp(0.82, 0.5, depth);\n    float n1 = frac(sin(dot(uv * 3 + time * 0.1, float2(12.9898, 78.233))) * 43758.5453);\n    float c1 = sin(uv.x * causticScale + time * causticSpeed + n1 * 2);\n    float c2 = sin(uv.x * causticScale * 1.3 - time * causticSpeed * 1.4 + uv.y * causticScale * 0.5 + 4.7);\n    float caustic = saturate(c1 * c2);\n    caustic = pow(caustic, 4) * causticStrength;\n    caustic *= smoothstep(0, 0.15, depth) * smoothstep(1, 0.55, depth);\n    color += causticColor * caustic * causticAlpha;\n    float2 normal = normalize(float2(-slope, 1));\n    float nDotL = saturate(dot(normal, normalize(lightDir)));\n    float specular = pow(nDotL, shininess) * depth;\n    color += specularColor * specular * specularAlpha;\n    float n2 = frac(sin(dot(float2(uv.x * sparkleScale + time * 0.3, uv.y * sparkleScale * 0.4 - time * 0.2), float2(12.9898, 78.233))) * 43758.5453);\n    float sparkle = smoothstep(sparkleThreshold, 1, n2) * depth * 0.4;\n    color += specularColor * sparkle;\n    float foamMask = 1 - smoothstep(0, foamWidth, depth);\n    color += foamColor * foamMask * foamAlpha;"
}

