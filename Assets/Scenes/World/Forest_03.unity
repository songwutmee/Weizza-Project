  m_EditorClassIdentifier: Weizza.Gameplay::Weizza.Narrative.ReadableNote
  title: A worn inscription
  body: 'Someone cut these marks a long time ago, and the moss has been closing over
    them ever since. Most of it is gone. What is left reads: <i>the way back is not
    the way you came</i>.'
  icon: {fileID: 0}
